# PatientTriage.ai Environment Configuration
# Copy this file to .env and fill in your API keys

# LLM Provider — choose one (system degrades gracefully if neither is set)
XAI_API_KEY="your-xai-api-key-here"
GROQ_API_KEY="your-groq-api-key-here"

# Optional: JWT secret for production (demo mode auto-generates one)
# JWT_SECRET="your-jwt-secret-here"
